powershell -Command "@'
# Python cache
__pycache__/
*.py[cod]

# Virtual environments
venv/
env/
.venv/
tf/

# Jupyter temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Training dataset
algo code/dataset/

# Test/input videos
input videos/
static/uploads/

# Generated video output
*.mp4

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary/log files
*.tmp
*.log
'@ | Set-Content -Encoding UTF8 .gitignore"